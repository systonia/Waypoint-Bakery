{
    "name": "systonia/waypoint-bakery",
    "description": "A bakery's online shop with pickup orders: the example app of Tenma, Waypoint, Waypoint-Live and the Waypoint plugins.",
    "type": "project",
    "license": "MIT OR Apache-2.0",
    "require": {
        "php": ">=8.5",
        "systonia/waypoint": "^0.7.11",
        "systonia/waypoint-charts": "^0.1.4",
        "systonia/waypoint-export": "^0.1.4",
        "systonia/waypoint-flash": "^0.2.4",
        "systonia/waypoint-i18n": "^0.2.4",
        "systonia/waypoint-live": "^0.2.5"
    },
    "require-dev": {
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^13.3",
        "tenma/stubs": "^0.1.19"
    },
    "autoload": {
        "psr-4": {
            "Bakery\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bakery\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    }
}
